/// A vessel in the StraitsLine feeder fleet.
entity Vessel
	lineageTag: a0000000-0000-4000-8000-000000000010
	backingTable: vessel
	keyProperty: VesselId

	property VesselId
		dataType: string
		lineageTag: 1e1511f7-ced3-5fa9-bcc0-6a9e67f9ae54

		backingConfiguration
			valueColumn: vessel.vessel_id

	property VesselName
		dataType: string
		lineageTag: a03cfb36-abb2-5b38-9271-ceac5686d275

		backingConfiguration
			valueColumn: vessel.name

	property TeuCapacity
		dataType: int64
		lineageTag: 07c0d54c-74c4-50d0-a56d-791f99832ba7

		backingConfiguration
			valueColumn: vessel.teu_capacity

