/// One round trip of a vessel on a service rotation.
entity Voyage
	lineageTag: a0000000-0000-4000-8000-000000000030
	backingTable: voyage
	keyProperty: VoyageId

	property VoyageId
		dataType: string
		lineageTag: 001a1fc8-a5e5-5cdb-ba93-a3e3bc711778

