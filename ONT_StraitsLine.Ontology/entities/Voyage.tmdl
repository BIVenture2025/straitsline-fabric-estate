			valueColumn: voyage.voyage_id

	property DepartureDate
		dataType: dateTime
		lineageTag: 5b0917ac-b81c-5eab-bfea-1775dd41a2bb

		backingConfiguration
			valueColumn: voyage.departure_date

	property ServiceName
